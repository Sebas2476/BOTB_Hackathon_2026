# Copy to server/.env and fill in any keys you have.
# Any provider without a key runs in SIMULATED mode so the app still works end to end.
PORT=3001

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Microsoft Copilot has no public consumer API. If you have an Azure OpenAI
# deployment (the same model family that powers Copilot) set these to use it;
# otherwise Copilot is simulated.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: Google PageSpeed Insights key for the website crawl's "Google's view".
# It works without a key at low volume; a key raises the quota.
GOOGLE_API_KEY=
